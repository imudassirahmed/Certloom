{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "certloom/verification-studio",
  "version": "1.0.0",
  "title": "Certloom Pro — Verification Studio",
  "category": "widgets",
  "icon": "shield-alt",
  "description": "Five profile-inspired verification designs and a responsive custom layout. Requires Certloom Pro.",
  "keywords": ["certificate", "verification", "pro"],
  "textdomain": "certloom",
  "attributes": {
    "preset": {"type": "string"},
    "desktop": {"type": "object", "default": {}},
    "tablet": {"type": "object", "default": {}},
    "mobile": {"type": "object", "default": {}},
    "colors": {"type": "object", "default": {}},
    "font_family": {"type": "string"},
    "heading_weight": {"type": "string"},
    "shadow": {"type": "string"},
    "heading": {"type": "string"},
    "eyebrow": {"type": "string"},
    "description": {"type": "string"},
    "placeholder": {"type": "string"},
    "button_text": {"type": "string"},
    "notfound_text": {"type": "string"},
    "heading_tag": {"type": "string", "default": "h2"},
    "content_order": {"type": "string", "default": "eyebrow-heading-description"},
    "show_guide": {"type": "boolean", "default": true}
  },
  "supports": {"html": false, "anchor": true, "align": ["wide", "full"]},
  "editorScript": "file:./index.js",
  "editorStyle": "file:./editor.css",
  "style": "certloom-pro-studio"
}
