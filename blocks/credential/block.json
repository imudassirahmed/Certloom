{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "certloom/credential",
  "version": "1.6.14",
  "title": "Certloom – Credential Profile",
  "category": "widgets",
  "icon": "id-alt",
  "description": "Display a known Certloom credential profile without a search form.",
  "keywords": [
    "certificate",
    "credential",
    "profile",
    "verification"
  ],
  "textdomain": "certloom",
  "attributes": {
    "number": {
      "type": "string",
      "default": ""
    },
    "heading": {
      "type": "string",
      "default": "Credential profile"
    },
    "notFoundText": {
      "type": "string",
      "default": "This credential could not be found or is not available."
    },
    "headingTag": {
      "type": "string",
      "default": "h2"
    }
  },
  "supports": {
    "align": [
      "wide",
      "full"
    ],
    "html": false,
    "anchor": true
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./editor.css",
  "style": "ecapla-certloom-public"
}
